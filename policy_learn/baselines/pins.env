# Pinned versions for the ACT / SmolVLA comparison baselines (verified 2026-10-30 against PyPI and the HF API).
# LeRobot 0.3.3 (2025-08-06) is the LAST release whose datasets are LeRobot v2.1 (CODEBASE_VERSION "v2.1"), the
# format GR00T N1.7 reads; 0.4.0 (2025-10-23) moved to v3.0. 0.3.3 ships both policies (lerobot.policies.act,
# lerobot.policies.smolvla) and predict_action_chunk on both. Its deps: torch>=2.2.1,<2.8, torchvision<0.23,
# transformers>=4.50.3,<4.52 (smolvla extra). torchvision 0.22's pyav reader passes av.open(metadata_errors=...),
# which av>=15 removed, so av is held below 15 (checked on CPU 2026-10-30: av 19 fails, av 14.2.0 decodes).
LEROBOT_VERSION=0.3.3
AV_SPEC="av>=14.2,<15"
PYTHON_VERSION=3.12
# SmolVLA base: the last revision before "Convert smolvla with Pipeline (#11)" (2025-10-10, LeRobot >=0.4 format).
SMOLVLA_BASE_ID=lerobot/smolvla_base
SMOLVLA_BASE_REV=3326b100334ffc0a0bd1ec27e3afb1cfa2a6000c
# Its VLM backbone, loaded by name (config vlm_model_name) from the HF cache; main sha on 2026-10-30.
SMOLVLM_ID=HuggingFaceTB/SmolVLM2-500M-Video-Instruct
SMOLVLM_REV=7b375e1b73b11138ff12fe22c8f2822d8fe03467
