# Pinned LeRobot 0.3.3 stack and base models for the ACT and SmolVLA comparison baselines.
# Authored by Shritej Gunda.
# LeRobot 0.3.3 is the last release with v2.1 datasets, the format GR00T N1.7 reads; av stays below 15 for torchvision 0.22.
LEROBOT_VERSION=0.3.3
AV_SPEC="av>=14.2,<15"
PYTHON_VERSION=3.12
# SmolVLA base: the last revision before "Convert smolvla with Pipeline (#11)" (LeRobot >=0.4 format).
SMOLVLA_BASE_ID=lerobot/smolvla_base
SMOLVLA_BASE_REV=3326b100334ffc0a0bd1ec27e3afb1cfa2a6000c
# Its VLM backbone, loaded by name (config vlm_model_name) from the HF cache; pinned main sha.
SMOLVLM_ID=HuggingFaceTB/SmolVLM2-500M-Video-Instruct
SMOLVLM_REV=7b375e1b73b11138ff12fe22c8f2822d8fe03467
