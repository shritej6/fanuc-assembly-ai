{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "pose_uf0": {
      "type": "object",
      "description": "UF0 frame, mm and deg (same as obs['tcp_pose'])",
      "required": [
        "x",
        "y",
        "z",
        "yaw"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "yaw": {
          "type": "number"
        }
      }
    },
    "part_id": {
      "enum": [
        "M1_01",
        "M1_02",
        "M1_03",
        "M1_04",
        "M2_01",
        "M2_02",
        "M2_03",
        "M2_04",
        "M3_01",
        "M3_02",
        "M3_03",
        "M3_04",
        "M4_01",
        "M4_02",
        "M4_03",
        "M4_04",
        "M5_01",
        "M5_02",
        "M5_03",
        "M5_04",
        "M6_01",
        "M6_02",
        "M6_03",
        "M6_04"
      ]
    },
    "base_id": {
      "enum": [
        "F01",
        "F02",
        "F03",
        "F04",
        "F05",
        "F06"
      ]
    },
    "family": {
      "enum": [
        "housing_control",
        "housing_connector",
        "carrier_stem",
        "cap_knob",
        "rear_guard",
        "insert",
        "guide",
        "lock",
        "base_A",
        "base_B",
        "base_C"
      ]
    },
    "object_id": {
      "enum": [
        "M1_01",
        "M1_02",
        "M1_03",
        "M1_04",
        "M2_01",
        "M2_02",
        "M2_03",
        "M2_04",
        "M3_01",
        "M3_02",
        "M3_03",
        "M3_04",
        "M4_01",
        "M4_02",
        "M4_03",
        "M4_04",
        "M5_01",
        "M5_02",
        "M5_03",
        "M5_04",
        "M6_01",
        "M6_02",
        "M6_03",
        "M6_04",
        "F01",
        "F02",
        "F03",
        "F04",
        "F05",
        "F06"
      ]
    },
    "base_type": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "camera": {
      "enum": [
        "table",
        "side",
        "wrist"
      ]
    },
    "error_code": {
      "description": "Team V error outcomes: the system reports one of these instead of guessing. Meanings in contracts/README.md.",
      "enum": [
        "WRONG_MODEL",
        "WRONG_PART",
        "WRONG_ORIENTATION",
        "WRONG_FRONT_BACK",
        "LOOKALIKE_UNRESOLVED",
        "GUARD_TOPPLED",
        "GRIP_FEATURE_INACCESSIBLE",
        "HOUSING_NOT_SEATED",
        "OCCLUDED",
        "COLLISION_RISK",
        "UNVERIFIED_MODEL3_GEOMETRY"
      ]
    }
  }
}
