{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taxonomy.schema.json",
  "title": "Object taxonomy (30 objects, families, base types)",
  "type": "object",
  "required": [
    "objects"
  ],
  "properties": {
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_id",
          "family",
          "product"
        ],
        "properties": {
          "object_id": {
            "$ref": "common.schema.json#/$defs/object_id"
          },
          "family": {
            "$ref": "common.schema.json#/$defs/family"
          },
          "product": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "base_type": {
            "$ref": "common.schema.json#/$defs/base_type"
          },
          "lookalikes": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/object_id"
            },
            "description": "visually confusable objects that require a wrist close-up, including near-surface matches and same-envelope size twins"
          }
        }
      }
    }
  }
}
